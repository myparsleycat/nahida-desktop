{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "electron.vite.config.*",
        "plugins/**/*",
        "src/main/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
        "../backend/**/*"
    ],
    "references": [
        {
            "path": "../backend"
        }
    ],
    "compilerOptions": {
        "composite": true,
        "types": [
            "electron-vite/node"
        ],
        "baseUrl": ".",
        "paths": {
            "@shared/*": [
                "src/shared/*"
            ],
            "@main/*": [
                "src/main/*"
            ],
            "@preload/*": [
                "src/preload/*"
            ],
            "@/*": [
                "src/*"
            ],
            "@backend/*": [
                "../backend/src/*"
            ],
            "elysia": [
                "../backend/node_modules/elysia"
            ],
            "@elysiajs/eden": [
                "../frontend/node_modules/@elysiajs/eden"
            ]
        },
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    }
}
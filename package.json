{
  "name": "nahida-desktop",
  "version": "2.50.1",
  "description": "Native app for nahida.live",
  "homepage": "https://nahida.live",
  "author": "nahida.live",
  "os": [
    "win32"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:dll-injector": "pnpm --dir native/dll-injector run build",
    "build:extractor": "pnpm --dir native/extractor run build",
    "build:fs": "pnpm --dir native/fs run build",
    "build:latest-installer:win": "powershell -ExecutionPolicy Bypass -File ./tools/latest-installer/build.ps1",
    "build:mod-manager": "pnpm --dir native/mod-manager run build",
    "build:mod-manager-tools": "pnpm --dir native/mod-tools run build",
    "build:native": "pnpm run build:dll-injector && pnpm run build:pe-padding-diversifier && pnpm run build:extractor && pnpm run build:mod-manager && pnpm run build:mod-manager-tools && pnpm run build:utils && pnpm run build:native-static-glb && pnpm run build:fs",
    "build:native-static-glb": "pnpm --dir native/static-glb run build",
    "build:pe-padding-diversifier": "pnpm --dir native/pe-padding-diversifier run build",
    "build:unpack": "pnpm run clean && pnpm run build && electron-builder --dir",
    "build:utils": "pnpm --dir native/utils run build",
    "build:win": "pnpm run clean && pnpm run build && electron-builder --win",
    "clean": "rimraf dist",
    "dev": "electron-vite dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "release:docs": "pnpm run docs:build && pnpm exec wrangler pages deploy docs/.vitepress/dist --project-name nahida-desktop-docs --branch main",
    "release:win": "pnpm run clean && pnpm run build && electron-builder --win --publish always",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "oxlint --type-aware --type-check"
  },
  "dependencies": {
    "@borewit/text-codec": "^0.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hono/node-server": "^2.0.8",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.8.0",
    "auto-launch": "^5.0.6",
    "cbor-x": "^1.6.4",
    "date-fns": "^4.4.0",
    "dds-ktx-parser": "^1.0.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "es-hangul": "^2.4.0",
    "es-toolkit": "^1.49.0",
    "fast-glob": "^3.3.3",
    "file-type": "^22.0.1",
    "filesize": "^11.0.22",
    "fs-extra": "^11.3.6",
    "hono": "^4.12.29",
    "html-to-text": "10.0.0",
    "ky": "^2.0.2",
    "mnemonist": "^0.40.4",
    "ms": "^2.1.3",
    "nanoid": "^5.1.16",
    "p-limit": "^7.3.0",
    "p-queue": "^9.3.1",
    "parse-sse": "^0.1.0",
    "pino": "^10.3.1",
    "piscina": "^5.2.0",
    "pngjs": "^7.0.0",
    "ps-list": "^9.0.0",
    "rotating-file-stream": "^3.2.9",
    "sharp": "^0.35.3",
    "valdex": "^1.0.4",
    "validator": "^13.15.35",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@elysiajs/eden": "^1.4.9",
    "@formkit/auto-animate": "^0.10.0",
    "@napi-rs/cli": "^3.7.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/auto-launch": "^5.0.5",
    "@types/electron-progressbar": "^2.2.0",
    "@types/filename-reserved-regex": "^3.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "26",
    "@types/path-browserify": "^1.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-virtuoso": "^4.18.10",
    "rimraf": "^6.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "zustand": "^5.0.14"
  }
}

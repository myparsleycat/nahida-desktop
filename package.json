{
  "name": "nahida-desktop",
  "version": "2.32.4",
  "description": "Native app for nahida.live",
  "homepage": "https://nahida.live",
  "author": "nahida.live",
  "main": "./out/main/index.js",
  "scripts": {
    "build:dll-injector": "cd native/dll-injector && pnpm install && pnpm run build",
    "build:extractor": "cd native/extractor && pnpm install && pnpm run build",
    "build:native-mod": "cd native/native-mod && pnpm install && pnpm run build",
    "build:native-util": "cd native/native-util && pnpm install && pnpm run build",
    "build:native-static-glb": "cd native/static-glb && pnpm install && pnpm run build",
    "build:native-fs": "cd native/native-fs && pnpm install && pnpm run build",
    "build:native": "pnpm run build:dll-injector && pnpm run build:extractor && pnpm run build:native-mod && pnpm run build:native-util && pnpm run build:native-static-glb && pnpm run build:native-fs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "start": "electron-vite preview",
    "dev": "pnpm run db:generate && electron-vite dev",
    "build": "pnpm run db:generate && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist",
    "build:unpack": "pnpm run clean && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run clean && pnpm run build && electron-builder --win",
    "build:mac": "pnpm run clean && pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run clean && pnpm run build && electron-builder --linux",
    "release:win": "pnpm run clean && pnpm run build && electron-builder --win --publish always",
    "release:mac": "pnpm run clean && pnpm run build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@borewit/text-codec": "^0.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",

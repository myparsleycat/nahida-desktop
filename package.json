    "@hono/node-ws": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^12.9.0",
    "cbor-x": "^1.6.4",
    "date-fns": "^4.1.0",
    "dds-ktx-parser": "^1.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "es-hangul": "^2.3.8",
    "es-toolkit": "^1.46.0",
    "fast-glob": "^3.3.3",
    "file-type": "^22.0.1",
    "filename-reserved-regex": "^4.0.0",
    "filesize": "^11.0.16",
    "fs-extra": "^11.3.4",
    "hono": "^4.12.15",
    "html-to-text": "^9.0.5",
    "koffi": "^2.16.1",
    "ky": "^2.0.2",
    "ms": "^2.1.3",
    "nanoid": "^5.1.9",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.2",

{
  "name": "nahida-desktop",
  "version": "2.39.2",
  "description": "Native app for nahida.live",
  "homepage": "https://nahida.live",
  "author": "nahida.live",
  "main": "./out/main/index.js",
  "scripts": {
    "build:dll-injector": "cd native/dll-injector && pnpm install && pnpm run build",
    "build:extractor": "cd native/extractor && pnpm install && pnpm run build",
    "build:mod-manager": "cd native/mod-manager && pnpm install && pnpm run build",
    "build:mod-manager-tools": "cd native/mod-tools && pnpm install && pnpm run build",
    "build:utils": "cd native/utils && pnpm install && pnpm run build",
    "build:native-static-glb": "cd native/static-glb && pnpm install && pnpm run build",
    "build:fs": "cd native/fs && pnpm install && pnpm run build",
    "build:native": "pnpm run build:dll-injector && pnpm run build:extractor && pnpm run build:mod-manager && pnpm run build:mod-manager-tools && pnpm run build:utils && pnpm run build:native-static-glb && pnpm run build:fs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "oxlint --type-aware --type-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist",
    "build:unpack": "pnpm run clean && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run clean && pnpm run build && electron-builder --win",
    "build:latest-installer:win": "powershell -ExecutionPolicy Bypass -File ./tools/latest-installer/build.ps1",
    "build:mac": "pnpm run clean && pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run clean && pnpm run build && electron-builder --linux",
    "release:win": "pnpm run clean && pnpm run build && electron-builder --win --publish always",
    "release:mac": "pnpm run clean && pnpm run build && electron-builder --mac --publish always",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:docs": "pnpm run docs:build && pnpm exec wrangler pages deploy docs/.vitepress/dist --project-name nahida-desktop-docs --branch main"
  },
  "dependencies": {
    "@borewit/text-codec": "^0.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hono/node-server": "^2.0.2",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.8.0",
    "auto-launch": "^5.0.6",
    "cbor-x": "^1.6.4",
    "date-fns": "^4.1.0",
    "dds-ktx-parser": "^1.0.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "es-hangul": "^2.3.8",
    "es-toolkit": "^1.46.1",
    "fast-glob": "^3.3.3",
    "file-type": "^22.0.1",
    "filesize": "^11.0.17",
    "fs-extra": "^11.3.5",
    "hono": "^4.12.18",
    "html-to-text": "10.0.0",
    "ky": "^2.0.2",
    "ms": "^2.1.3",
    "nanoid": "^5.1.11",
    "p-limit": "^7.3.0",
    "p-queue": "^9.2.0",
    "parse-sse": "^0.1.0",
    "pino": "^10.3.1",
    "piscina": "^5.1.4",
    "pngjs": "^7.0.0",
    "ps-list": "^9.0.0",
    "rotating-file-stream": "^3.2.9",
    "sharp": "^0.34.5",
    "undici": "^7.24.6",
    "valdex": "^1.0.4",
    "validator": "^13.15.35",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@elysiajs/eden": "^1.4.9",
    "@formkit/auto-animate": "^0.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/auto-launch": "^5.0.5",
    "@types/electron-progressbar": "^2.2.0",
    "@types/filename-reserved-regex": "^3.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "24",
    "@types/path-browserify": "^1.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "path-browserify": "^1.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.7",
    "rimraf": "^6.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitepress": "2.0.0-alpha.17",
    "wrangler": "^4.90.0",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}

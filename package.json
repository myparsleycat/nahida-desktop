{
    "name": "nahida-desktop",
    "version": "1.2.3",
    "description": "Native app for nahida.live",
    "main": "./out/main/index.js",
    "author": "nahida.live",
    "homepage": "https://nahida.live",
    "type": "module",
    "scripts": {
        "go:build": "cd build/extractor && go build -ldflags \"-s -w\" -o extractor.exe",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
        "db:generate": "drizzle-kit generate",
        "start": "electron-vite preview",
        "dev": "pnpm run db:generate && pnpm run go:build && electron-vite dev",
        "build": "pnpm run db:generate && pnpm run go:build && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "rimraf dist && pnpm run build && electron-builder --dir",
        "build:win": "rimraf dist && pnpm run build && electron-builder --win",
        "build:mac": "rimraf dist && electron-vite build && electron-builder --mac",
        "build:linux": "rimraf dist && electron-vite build && electron-builder --linux",
        "release": "pnpm run build && electron-builder --win"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@hono/node-server": "^1.19.9",
        "@hono/zod-validator": "^0.7.6",
        "auto-launch": "^5.0.6",
        "better-sqlite3": "^12.6.2",
        "cbor-x": "^1.6.0",
        "chokidar": "^5.0.0",
        "date-fns": "^4.1.0",
        "drizzle-orm": "^0.45.1",
        "electron-log": "^5.4.3",
        "electron-progressbar": "^2.2.1",
        "electron-updater": "^6.7.3",
        "es-hangul": "^2.3.8",
        "es-toolkit": "^1.44.0",
        "fast-glob": "^3.3.3",
        "file-type": "^21.3.0",
        "filename-reserved-regex": "^4.0.0",
        "filesize": "^11.0.13",
        "fs-extra": "^11.3.3",
        "fzstd": "^0.1.1",
        "hono": "^4.11.4",
        "html-to-text": "^9.0.5",
        "ky": "^1.14.2",
        "nanoid": "^5.1.6",
        "p-limit": "^7.2.0",
        "p-queue": "^9.1.0",
        "parse-sse": "^0.1.0",
        "path-browserify": "^1.0.1",
        "pino": "^10.2.1",
        "rotating-file-stream": "^3.2.7",
        "undici": "^7.18.2",
        "valdex": "^1.0.4",
        "validator": "^13.15.26",
        "write-file-atomic": "^7.0.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@elysiajs/eden": "^1.4.6",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-slot": "^1.2.4",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-form": "^1.27.7",
        "@tanstack/react-query": "^5.90.19",
        "@tanstack/react-router": "^1.153.2",
        "@tanstack/react-virtual": "^3.13.18",
        "@tanstack/router-plugin": "^1.153.2",
        "@types/auto-launch": "^5.0.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/electron-progressbar": "^2.2.0",
        "@types/filename-reserved-regex": "^3.0.0",
        "@types/html-to-text": "^9.0.4",
        "@types/node": "^25.0.9",
        "@types/node-7z": "^2.1.11",
        "@types/path-browserify": "^1.0.3",
        "@types/react": "^19.2.9",
        "@types/react-dom": "^19.2.3",
        "@types/unzipper": "^0.10.11",
        "@types/validator": "^13.15.10",
        "@vitejs/plugin-react": "^5.1.2",
        "class-variance-authority": "^0.7.1",
        "dotenv": "^17.2.3",
        "drizzle-kit": "^0.31.8",
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "i18next-browser-languagedetector": "^8.2.0",
        "lucide-react": "^0.562.0",
        "motion": "^12.27.5",
        "prettier": "^3.8.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.3",
        "react-day-picker": "^9.13.0",
        "react-dom": "^19.2.3",
        "react-i18next": "^16.5.3",
        "rimraf": "^6.1.2",
        "rollup-plugin-visualizer": "^6.0.5",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "npm:rolldown-vite@latest",
        "zustand": "^5.0.10"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    }
}
